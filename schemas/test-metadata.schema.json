{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Final Test Metadata",
  "type": "object",
  "required": ["id", "subtask", "role", "input", "output"],
  "properties": {
    "id": {"type": "integer", "minimum": 1},
    "subtask": {"type": ["string", "null"]},
    "role": {"type": "array", "items": {"type": "string"}},
    "target_wrong_solutions": {"type": "array", "items": {"type": "string"}},
    "input": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": {"type": "string"},
        "generator": {"type": ["string", "null"]},
        "seed": {"type": ["integer", "string", "null"]},
        "parameters": {"type": "object"}
      },
      "additionalProperties": true
    },
    "output": {
      "type": "object",
      "required": ["path", "generated_by"],
      "properties": {
        "path": {"type": "string"},
        "generated_by": {"type": "string"},
        "answer_bucket": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "verification": {"type": "object"}
  },
  "additionalProperties": true
}
