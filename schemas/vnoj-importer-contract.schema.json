{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FuraOJ / VNOJ Polygon Importer Contract",
  "type": "object",
  "required": ["statement", "problem_properties", "testset", "checker"],
  "properties": {
    "statement": {"type": "object", "required": ["type", "path", "language"]},
    "problem_properties": {"type": "object", "required": ["legend", "input", "output", "interaction", "scoring", "sampleTests", "notes", "tutorial"]},
    "testset": {
      "type": "object",
      "required": ["name", "input_path_pattern", "answer_path_pattern"],
      "properties": {
        "time_limit_ms": {"type": "integer", "default": 1000},
        "memory_limit_bytes": {"type": "integer", "default": 1073741824},
        "default_points": {"type": "number", "default": 1}
      }
    },
    "checker": {"type": "object", "required": ["type"]}
  }
}

